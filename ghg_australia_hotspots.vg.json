{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Australian 2025 GHG emissions aggregated to equal-area Albers square bins.",
  "width": 570,
  "height": 505,
  "background": null,
  "padding": 8,
  "params": [
    {
      "name": "Grid_km",
      "value": 50
    }
  ],
  "projection": {
    "type": "identity",
    "reflectY": true
  },
  "layer": [
    {
      "data": {
        "url": "data/ghg_australia_hotspots_bins.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.grid_km == Grid_km"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#f7f6ef",
        "strokeWidth": 0.35
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "isValid(datum.properties.emissions_kt)",
            "field": "properties.emissions_kt",
            "type": "quantitative",
            "scale": {
              "type": "threshold",
              "domain": [
                1,
                10,
                50,
                250,
                1000
              ],
              "range": [
                "#eee9c9",
                "#ced7a8",
                "#a6bf87",
                "#69a68c",
                "#2e8279",
                "#15514d"
              ]
            },
            "legend": null
          },
          "value": "#dddcd4"
        },
        "tooltip": [
          {
            "field": "properties.grid_km",
            "type": "quantitative",
            "title": "Grid width (km)"
          },
          {
            "field": "properties.emissions_kt",
            "type": "quantitative",
            "title": "Annual emissions (kt CO₂eq)",
            "format": ",.2f"
          },
          {
            "field": "properties.share",
            "type": "quantitative",
            "title": "Share of mapped emissions",
            "format": ".2%"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/ghg_australia_hotspots_boundary.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#6f8070",
        "strokeWidth": 0.65,
        "tooltip": null
      }
    },
