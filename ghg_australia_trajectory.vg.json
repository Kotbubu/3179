{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Connected scatterplot traces Australian annual emissions against population-weighted national emissions per person, 1970–2025. Arrows indicate the direction of time.",
  "width": "container",
  "height": 390,
  "autosize": {
    "type": "none",
    "contains": "padding",
    "resize": true
  },
  "background": "transparent",
  "data": {
    "url": "data/ghg_australia_trajectory.json"
  },
  "params": [
    {
      "name": "focus_year",
      "value": 2025
    },
    {
      "name": "detail_view",
      "value": false
    }
  ],
  "encoding": {
    "x": {
      "field": "emissions_mt",
      "type": "quantitative",
      "scale": {
        "domain": {
          "expr": "detail_view ? [280,660] : [0,660]"
        },
        "nice": false
      },
      "title": "Australia’s annual emissions (Mt CO₂eq)"
    },
    "y": {
      "field": "per_person",
      "type": "quantitative",
      "scale": {
        "domain": {
          "expr": "detail_view ? [18,31] : [0,31]"
        },
        "nice": false
      },
      "title": "Annual emissions per person (tonnes CO₂eq)"
    },
    "tooltip": [
      {
        "field": "year",
        "title": "Year"
      },
      {
        "field": "emissions_mt",
        "title": "National emissions (Mt CO₂eq)",
        "format": ",.1f"
      },
      {
        "field": "per_person",
        "title": "Tonnes CO₂eq per person",
        "format": ".1f"
      },
      {
        "field": "population",
        "title": "Population",
        "format": ",.0f"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.2,
        "color": "#176e63"
      },
      "encoding": {
        "order": {
          "field": "year",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 18,
        "color": "#176e63",
        "opacity": 0.55
      }
    },
    {
      "transform": [
        {
          "filter": {
            "field": "year",
            "oneOf": [
              1980,
              1990,
              2000,
              2010,
              2020
            ]
          }
        },
        {
          "calculate": "atan2(datum.delta_total * width / (detail_view ? 380 : 660), datum.delta_person * height / (detail_view ? 13 : 31)) * 180 / PI",
          "as": "direction"
        }
      ],
      "mark": {
        "type": "point",
        "shape": "triangle-up",
        "filled": true,
        "size": 210,
        "color": "#104e46",
        "opacity": 1,
        "stroke": "#f7f6ef",
        "strokeWidth": 1.25
      },
      "encoding": {
        "angle": {
          "field": "direction",
          "type": "quantitative",
          "scale": null
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == focus_year"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 145,
        "color": "#b56b2a",
        "stroke": "#f7f6ef",
        "strokeWidth": 1.5,
        "opacity": 1
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 1970 && datum.year != focus_year"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Manrope",
        "fontSize": 11,
        "fontWeight": 600,
        "align": "left",
        "dx": 10,
        "dy": -12,
        "color": "#173f35",
        "stroke": "#f7f6ef",
        "strokeWidth": 3
      },
      "encoding": {
        "text": {
          "value": "1970"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 1970 && datum.year != focus_year"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Manrope",
        "fontSize": 11,
        "fontWeight": 600,
        "align": "left",
        "dx": 10,
        "dy": -12,
        "color": "#173f35"
      },
      "encoding": {
        "text": {
          "value": "1970"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "detail_view && (datum.year == 2002 && datum.year != focus_year)"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Manrope",
        "fontSize": 11,
        "fontWeight": 600,
        "align": "center",
        "dx": 0,
        "dy": -16,
        "color": "#173f35",
        "stroke": "#f7f6ef",
        "strokeWidth": 3
      },
      "encoding": {
        "text": {
          "value": "2002 · per-person peak"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "detail_view && (datum.year == 2002 && datum.year != focus_year)"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Manrope",
        "fontSize": 11,
        "fontWeight": 600,
        "align": "center",
        "dx": 0,
        "dy": -16,
        "color": "#173f35"
      },
      "encoding": {
        "text": {
          "value": "2002 · per-person peak"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "detail_view && (datum.year == 2012 && datum.year != focus_year)"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Manrope",
        "fontSize": 11,
        "fontWeight": 600,
        "align": "right",
        "dx": -10,
        "dy": -3,
        "color": "#173f35",
        "stroke": "#f7f6ef",
        "strokeWidth": 3
      },
      "encoding": {
        "text": {
          "value": "2012 · total peak"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "detail_view && (datum.year == 2012 && datum.year != focus_year)"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Manrope",
        "fontSize": 11,
        "fontWeight": 600,
        "align": "right",
        "dx": -10,
        "dy": -3,
        "color": "#173f35"
      },
      "encoding": {
        "text": {
          "value": "2012 · total peak"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2025 && datum.year != focus_year"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Manrope",
        "fontSize": 11,
        "fontWeight": 600,
        "align": "left",
        "dx": 10,
        "dy": 12,
        "color": "#173f35",
        "stroke": "#f7f6ef",
        "strokeWidth": 3
      },
      "encoding": {
        "text": {
          "value": "2025"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2025 && datum.year != focus_year"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Manrope",
        "fontSize": 11,
        "fontWeight": 600,
        "align": "left",
        "dx": 10,
        "dy": 12,
        "color": "#173f35"
      },
      "encoding": {
        "text": {
          "value": "2025"
        }
      }
    },
    {
      "name": "selected_year_values_halo",
      "transform": [
        {
          "filter": "datum.year == focus_year"
        },
        {
          "calculate": "[format(datum.year, 'd'), 'Total: ' + format(datum.emissions_mt, ',.1f') + ' Mt CO₂eq', 'Per person: ' + format(datum.per_person, '.1f') + ' t CO₂eq']",
          "as": "live_label"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Manrope",
        "fontSize": 11,
        "fontWeight": 600,
        "align": {
          "expr": "datum.emissions_mt > (detail_view ? 470 : 330) ? 'right' : 'left'"
        },
        "dx": {
          "expr": "datum.emissions_mt > (detail_view ? 470 : 330) ? -14 : 14"
        },
        "dy": {
          "expr": "scale('y', datum.per_person) < 65 ? 18 : -54"
        },
        "baseline": "top",
        "lineHeight": 16,
        "color": "#8a5425",
        "stroke": "#f7f6ef",
        "strokeWidth": 4,
        "strokeJoin": "round",
        "clip": true
      },
      "encoding": {
        "text": {
          "field": "live_label",
          "type": "nominal"
        },
        "tooltip": null
      }
    },
    {
      "name": "selected_year_values",
      "transform": [
        {
          "filter": "datum.year == focus_year"
        },
        {
          "calculate": "[format(datum.year, 'd'), 'Total: ' + format(datum.emissions_mt, ',.1f') + ' Mt CO₂eq', 'Per person: ' + format(datum.per_person, '.1f') + ' t CO₂eq']",
          "as": "live_label"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Manrope",
        "fontSize": 11,
        "fontWeight": 600,
        "align": {
          "expr": "datum.emissions_mt > (detail_view ? 470 : 330) ? 'right' : 'left'"
        },
        "dx": {
          "expr": "datum.emissions_mt > (detail_view ? 470 : 330) ? -14 : 14"
        },
        "dy": {
          "expr": "scale('y', datum.per_person) < 65 ? 18 : -54"
        },
        "baseline": "top",
        "lineHeight": 16,
        "color": "#8a5425",
        "clip": true
      },
      "encoding": {
        "text": {
          "field": "live_label",
          "type": "nominal"
        },
        "tooltip": null
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Manrope",
    "axis": {
      "domain": false,
      "ticks": false,
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleFontWeight": 400,
      "labelColor": "#526358",
      "titleColor": "#526358",
      "gridColor": "#e2e6dc",
      "labelPadding": 7
    }
  },
  "padding": {
    "left": 68,
    "right": 18,
    "top": 22,
    "bottom": 52
  }
}
