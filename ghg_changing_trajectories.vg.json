{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Annual greenhouse gas emissions for six selected countries, 1970–2025; excludes land use, land-use change and forestry.",
  "width": "container",
  "height": 300,
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "background": "transparent",
  "data": {
    "url": "data/ghg_by_year.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "emissions_mt": "number"
      }
    }
  },
  "transform": [
    {
      "filter": {
        "field": "iso_code",
        "oneOf": [
          "CHN",
          "USA",
          "IND",
          "RUS",
          "JPN",
          "AUS"
        ]
      }
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": "Year",
      "scale": {
        "domain": [
          1970,
          2025
        ],
        "nice": false
      },
      "axis": {
        "format": "d",
        "values": [
          1970,
          1980,
          1990,
          2000,
          2010,
          2020,
          2025
        ],
        "grid": false,
        "labelOverlap": true
      }
    },
    "y": {
      "field": "emissions_mt",
      "type": "quantitative",
      "title": "Emissions (Mt CO₂eq)",
      "scale": {
        "zero": true
      },
      "axis": {
        "format": ",.0f",
        "tickCount": 6
      }
    },
    "color": {
      "field": "country",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "China",
          "United States",
          "India",
          "Russian Federation",
          "Japan",
          "Australia"
        ],
        "range": [
          "#176e63",
          "#b56b2a",
          "#548faf",
          "#8c719d",
          "#66756c",
          "#b64d54"
        ]
      },
      "legend": null
    },
    "order": {
      "field": "year",
      "type": "quantitative"
    }
  },
  "config": {
    "font": "Segoe UI",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "labelColor": "#6a736c",
      "titleColor": "#46584d",
      "gridColor": "#dedfd4",
      "domainColor": "#bbc8b8",
      "titlePadding": 12,
      "domain": false,
      "ticks": false,
      "gridOpacity": 0.65,
      "labelPadding": 8,
      "titleFontWeight": 400,
      "labelFont": "Segoe UI",
      "titleFont": "Segoe UI"
    },
    "legend": {
      "labelFontSize": 12,
      "labelColor": "#526358",
      "padding": 14,
      "labelFont": "Segoe UI",
      "titleFont": "Segoe UI"
    },
    "text": {
      "font": "Segoe UI"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.8,
        "clip": true
      },
      "encoding": {
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "emissions_mt",
            "type": "quantitative",
            "title": "Emissions (Mt CO₂eq)",
            "format": ",.1f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "year": 2004
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [
          4,
          4
        ],
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative"
        },
        "y": {
          "value": 0
        },
        "y2": {
          "value": 300
        },
        "color": {
          "value": "#708074"
        },
        "opacity": {
          "value": 0.65
        },
        "tooltip": {
          "value": "2004: China first exceeds United States emissions."
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "year": 2004,
            "label": [
              "2004: China’s annual emissions",
              "first exceed US emissions."
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 11,
        "fontWeight": 500,
        "lineBreak": "\n",
        "dx": 10,
        "font": "Segoe UI"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative"
        },
        "y": {
          "value": 20
        },
        "text": {
          "field": "label"
        },
        "color": {
          "value": "#253d35"
        },
        "opacity": {
          "value": 1
        },
        "tooltip": {
          "value": "China first exceeds United States emissions in 2004 in this dataset."
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.iso_code == 'CHN' && datum.year == 2023"
        },
        {
          "calculate": "datum.country == 'Russian Federation' ? 'Russia' : datum.country",
          "as": "country_label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "dy": -12,
        "fontSize": 11,
        "fontWeight": 500,
        "clip": false,
        "stroke": "#f7f6ef",
        "strokeWidth": 4,
        "strokeJoin": "round"
