      "labelFontSize": 12,
      "labelColor": "#526358",
      "padding": 14,
      "labelFont": "Manrope",
      "titleFont": "Manrope",
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "titleColor": "#173f35"
