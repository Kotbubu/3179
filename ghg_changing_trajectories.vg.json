{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Annual greenhouse gas emissions for six selected countries, 1970–2025; excludes land use, land-use change and forestry.",
  "width": "container",
  "height": 300,
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "background": "transparent",
  "data": {
    "url": "data/ghg_by_year.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "emissions_mt": "number"
      }
    }
  },
  "transform": [
    {
      "filter": {
        "field": "iso_code",
        "oneOf": [
          "CHN",
          "USA",
          "IND",
          "RUS",
          "JPN",
          "AUS"
        ]
      }
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": "Year",
      "scale": {
        "domain": [
          1970,
          2025
        ],
        "nice": false
      },
      "axis": {
        "format": "d",
        "values": [
          1970,
          1980,
          1990,
          2000,
          2010,
          2020,
          2025
        ],
        "grid": false,
        "labelOverlap": true,
        "labelFont": "Manrope",
        "titleFont": "Manrope",
        "labelFontSize": 12,
        "titleFontSize": 13,
        "titleFontWeight": 400,
        "labelColor": "#526358",
        "titleColor": "#526358"
      }
    },
    "y": {
      "field": "emissions_mt",
      "type": "quantitative",
      "title": "Emissions (Mt CO₂eq)",
      "scale": {
        "zero": true
      },
      "axis": {
        "format": ",.0f",
        "tickCount": 6,
        "labelFont": "Manrope",
        "titleFont": "Manrope",
        "labelFontSize": 12,
        "titleFontSize": 13,
        "titleFontWeight": 400,
        "labelColor": "#526358",
        "titleColor": "#526358"
      }
    },
    "color": {
      "field": "country",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "China",
          "United States",
          "India",
          "Russian Federation",
          "Japan",
          "Australia"
        ],
        "range": [
          "#176e63",
          "#b56b2a",
          "#548faf",
          "#8c719d",
          "#66756c",
          "#b64d54"
        ]
      },
      "legend": null
    },
    "order": {
      "field": "year",
      "type": "quantitative"
    }
  },
  "config": {
    "font": "Manrope",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "labelColor": "#526358",
      "titleColor": "#526358",
      "gridColor": "#dedfd4",
      "domainColor": "#bbc8b8",
      "titlePadding": 12,
      "domain": false,
      "ticks": false,
      "gridOpacity": 0.65,
      "labelPadding": 8,
      "titleFontWeight": 400,
      "labelFont": "Manrope",
      "titleFont": "Manrope"
