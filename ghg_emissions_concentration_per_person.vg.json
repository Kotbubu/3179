{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 280,
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "background": "transparent",
  "projection": {
    "type": "equalEarth"
  },
  "params": [
    {
      "name": "Year_selection",
      "value": 2025
    }
  ],
  "data": {
    "url": "data/world.geojson",
    "format": {
      "type": "json",
      "property": "features"
    }
  },
  "transform": [
    {
      "calculate": "datum.properties.ISO_A3 != '-99' ? datum.properties.ISO_A3 : datum.properties.ADM0_A3",
      "as": "iso_code"
    },
    {
      "calculate": "datum.iso_code + '_' + Year_selection",
      "as": "iso_year"
    },
    {
      "lookup": "iso_year",
      "from": {
        "data": {
          "url": "data/ghg_per_capita_by_year.csv",
          "format": {
            "type": "csv",
            "parse": {
              "ghg_per_capita": "number",
              "population": "number"
            }
          }
        },
        "key": "iso_year",
        "fields": [
          "country",
          "ghg_per_capita",
          "population"
        ]
      }
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 0.5
  },
  "encoding": {
    "color": {
      "condition": {
        "test": "isValid(datum.ghg_per_capita)",
        "field": "ghg_per_capita",
        "type": "quantitative",
        "title": "Tonnes CO₂eq per person",
        "scale": {
          "type": "threshold",
          "domain": [
            2,
            5,
            10,
            20,
            40
          ],
          "scheme": "yelloworangered"
        },
        "legend": {
          "orient": "bottom",
          "direction": "horizontal",
          "labelFontSize": 10,
          "titleFontSize": 11
        }
      },
      "value": "#d9dfd9"
    },
    "tooltip": [
      {
        "field": "properties.NAME",
        "title": "Country"
      },
      {
        "field": "ghg_per_capita",
        "type": "quantitative",
        "title": "Tonnes CO₂eq per person",
        "format": ".2f"
      },
      {
        "field": "population",
        "type": "quantitative",
        "title": "Population",
        "format": ",.0f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Segoe UI",
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "labelColor": "#526358",
      "titleColor": "#253d35",
      "labelFont": "Segoe UI",
      "titleFont": "Segoe UI"
    },
    "axis": {
      "labelFont": "Segoe UI",
      "titleFont": "Segoe UI"
    },
    "text": {
      "font": "Segoe UI"
    }
  }
}