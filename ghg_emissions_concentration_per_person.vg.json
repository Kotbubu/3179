{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 280,
  "autosize": {
    "type": "none",
    "contains": "padding",
    "resize": true
  },
  "background": "transparent",
  "projection": {
    "type": "equalEarth",
    "scale": {
      "expr": "max(1,min((width-130)/5.45,(height-50)/2.65))"
    },
    "translate": {
      "expr": "[width/2,height/2]"
    }
  },
  "params": [
    {
      "name": "Year_selection",
      "value": 2025
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Manrope",
    "legend": null,
    "axis": {
      "labelFont": "Manrope",
      "titleFont": "Manrope",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleFontWeight": 400,
      "labelColor": "#526358",
      "titleColor": "#526358"
    },
    "text": {
      "font": "Manrope"
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/world.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "calculate": "datum.properties.ISO_A3 != '-99' ? datum.properties.ISO_A3 : datum.properties.ADM0_A3",
          "as": "iso_code"
        },
        {
          "calculate": "datum.iso_code + '_' + Year_selection",
          "as": "iso_year"
        },
        {
          "lookup": "iso_year",
          "from": {
            "data": {
              "url": "data/ghg_per_capita_by_year.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "ghg_per_capita": "number",
                  "population": "number"
                }
              }
            },
            "key": "iso_year",
            "fields": [
              "country",
              "ghg_per_capita",
              "population"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 0.5
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "isValid(datum.ghg_per_capita)",
            "field": "ghg_per_capita",
            "type": "quantitative",
            "title": "Tonnes CO₂eq per person",
            "scale": {
              "type": "threshold",
              "domain": [
                2,
                5,
                10,
                20,
                40
              ],
              "scheme": "yelloworangered"
            },
            "legend": null
          },
          "value": "#d9dfd9"
        },
        "tooltip": [
          {
            "field": "properties.NAME",
            "title": "Country"
          },
          {
            "field": "ghg_per_capita",
            "type": "quantitative",
            "title": "Tonnes CO₂eq per person",
            "format": ".2f"
          },
          {
            "field": "population",
            "type": "quantitative",
            "title": "Population",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/continent_annotation_boundaries.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fillOpacity": 0,
        "stroke": "#24332b",
        "strokeWidth": 0.65,
        "strokeOpacity": 0.65
      },
      "encoding": {
        "tooltip": null
      },
      "name": "continent_outlines"
    },
    {
      "data": {
        "url": "data/continent_annotation_leaders.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#24332b",
        "strokeWidth": 0.7,
        "strokeOpacity": 0.8
      },
      "encoding": {
        "tooltip": null,
        "opacity": {
          "condition": {
            "test": "width >= 600",
            "value": 1
          },
          "value": 0
        }
      },
      "name": "continent_leaders"
    },
    {
      "data": {
        "url": "data/continent_map_annotations.json"
      },
      "transform": [
        {
          "filter": "datum.year == Year_selection"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Manrope",
        "fontSize": 11,
        "fontWeight": 500,
        "lineHeight": 14,
        "lineBreak": "\n",
        "align": "center",
        "baseline": "middle",
        "color": "#173f35",
        "stroke": "#f7f6ef",
        "strokeWidth": 3,
        "strokeOpacity": 0.95
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "person_label"
        },
        "tooltip": null,
        "opacity": {
          "condition": {
            "test": "width >= 600",
            "value": 1
          },
          "value": 0
        }
      },
      "name": "continent_label_halo"
    },
    {
      "data": {
        "url": "data/continent_map_annotations.json"
      },
      "transform": [
        {
          "filter": "datum.year == Year_selection"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Manrope",
        "fontSize": 11,
        "fontWeight": 500,
        "lineHeight": 14,
        "lineBreak": "\n",
        "align": "center",
        "baseline": "middle",
        "color": "#173f35"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "person_label"
        },
        "tooltip": null,
        "opacity": {
          "condition": {
            "test": "width >= 600",
            "value": 1
          },
          "value": 0
        }
      },
      "name": "continent_labels"
    }
  ],
  "padding": {
    "left": 8,
    "right": 8,
    "top": 8,
    "bottom": 8
  }
}