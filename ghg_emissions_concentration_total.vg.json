{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 280,
  "projection": {
    "type": "equalEarth",
    "scale": {
      "expr": "max(1,min((width-130)/5.45,(height-50)/2.65))"
    },
    "translate": {
      "expr": "[width/2,height/2]"
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/world.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e6e9e7",
        "stroke": "white",
        "strokeWidth": 0.6
      }
    },
    {
      "data": {
        "url": "data/ghg_by_year.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "emissions_mt": "number",
            "longitude": "number",
            "latitude": "number"
          }
        }
      },
      "mark": {
        "type": "circle",
        "color": "#227c72",
        "opacity": 0.65,
        "stroke": "#124e48",
        "strokeWidth": 0.7
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "emissions_mt",
          "type": "quantitative",
          "title": "Emissions (Mt CO₂eq)",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              15980.974040899
            ],
            "range": [
              0,
              1700
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "emissions_mt",
            "type": "quantitative",
            "title": "Emissions (Mt CO₂eq)",
            "format": ",.1f"
          }
        ]
      },
      "transform": [
        {
          "filter": "datum.year == Year_selection"
        }
      ]
    },
    {
      "data": {
        "url": "data/continent_annotation_boundaries.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fillOpacity": 0,
        "stroke": "#24332b",
        "strokeWidth": 0.65,
        "strokeOpacity": 0.65
      },
      "encoding": {
        "tooltip": null
      },
      "name": "continent_outlines"
    },
    {
      "data": {
        "url": "data/continent_annotation_leaders.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#24332b",
        "strokeWidth": 0.7,
        "strokeOpacity": 0.8
      },
      "encoding": {
        "tooltip": null,
        "opacity": {
          "condition": {
            "test": "width >= 600",
            "value": 1
          },
          "value": 0
        }
      },
      "name": "continent_leaders"
    },
    {
      "data": {
        "url": "data/continent_map_annotations.json"
      },
      "transform": [
        {
          "filter": "datum.year == Year_selection"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Manrope",
        "fontSize": 11,
        "fontWeight": 500,
        "lineHeight": 14,
        "lineBreak": "\n",
        "align": "center",
        "baseline": "middle",
        "color": "#173f35",
        "stroke": "#f7f6ef",
        "strokeWidth": 3,
        "strokeOpacity": 0.95
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "total_label"
        },
        "tooltip": null,
        "opacity": {
          "condition": {
            "test": "width >= 600",
            "value": 1
          },
          "value": 0
        }
      },
      "name": "continent_label_halo"
    },
    {
      "data": {
        "url": "data/continent_map_annotations.json"
      },
      "transform": [
        {
          "filter": "datum.year == Year_selection"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Manrope",
        "fontSize": 11,
        "fontWeight": 500,
        "lineHeight": 14,
        "lineBreak": "\n",
        "align": "center",
        "baseline": "middle",
        "color": "#173f35"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "total_label"
        },
        "tooltip": null,
        "opacity": {
          "condition": {
            "test": "width >= 600",
            "value": 1
          },
          "value": 0
        }
      },
      "name": "continent_labels"
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Manrope",
    "legend": null,
    "axis": {
      "labelFont": "Manrope",
      "titleFont": "Manrope",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleFontWeight": 400,
      "labelColor": "#526358",
      "titleColor": "#526358"
    },
    "text": {
      "font": "Manrope"
    }
  },
  "autosize": {
    "type": "none",
    "contains": "padding",
    "resize": true
  },
  "params": [
    {
      "name": "Year_selection",
      "value": 2025
    }
  ],
  "background": "transparent",
  "padding": {
    "left": 8,
    "right": 8,
    "top": 8,
    "bottom": 8
  }
}