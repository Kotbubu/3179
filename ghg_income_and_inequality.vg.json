{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 280,
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "background": "transparent",
  "data": {
    "url": "data/ghg_income_distribution_2025.csv",
    "format": {
      "type": "csv",
      "parse": {
        "group_index": "number",
        "jitter": "number",
        "ghg_per_capita": "number",
        "population": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.group_index + datum.jitter",
      "as": "jitter_x"
    }
  ],
  "encoding": {
    "x": {
      "field": "jitter_x",
      "type": "quantitative",
      "title": null,
      "scale": {
        "domain": [
          -0.55,
          3.55
        ],
        "nice": false
      },
      "axis": {
        "values": [
          0,
          1,
          2,
          3
        ],
        "labelExpr": "['Low income','Lower middle income','Upper middle income','High income'][datum.value]",
        "labelAngle": 0,
        "labelLimit": 180,
        "grid": false,
        "labelPadding": 14
      }
    },
    "y": {
      "field": "ghg_per_capita",
      "type": "quantitative",
      "title": "Annual emissions per person (tonnes CO₂eq)",
      "scale": {
        "domain": [
          0,
          100
        ],
        "nice": false,
        "zero": true
      },
      "axis": {
        "values": [
          0,
          20,
          40,
          60,
          80,
          100
        ],
        "format": ".0f"
      }
    },
    "tooltip": [
      {
        "field": "country",
        "title": "Country"
      },
      {
        "field": "income_group",
        "title": "Income group"
      },
      {
        "field": "ghg_per_capita",
        "type": "quantitative",
        "title": "2025 tonnes CO₂eq per person",
        "format": ".2f"
      },
      {
        "field": "population",
        "type": "quantitative",
        "title": "Population",
        "format": ",.0f"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "circle",
        "size": 42,
        "opacity": 0.7,
        "stroke": "#f7f6ef",
        "strokeWidth": 0.5
      },
      "encoding": {
        "color": {
          "field": "income_group",
          "type": "nominal",
          "scale": {
            "domain": [
              "Low income",
              "Lower middle income",
              "Upper middle income",
              "High income"
            ],
            "range": [
              "#7d9252",
              "#36958b",
              "#5487b0",
              "#8770a2"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "median",
              "field": "ghg_per_capita",
              "as": "median_value"
            }
          ],
          "groupby": [
            "income_group",
            "group_index"
          ]
        },
        {
          "calculate": "datum.group_index - 0.32",
          "as": "left"
        },
        {
          "calculate": "datum.group_index + 0.32",
          "as": "right"
        }
      ],
      "mark": {
        "type": "rule",
        "strokeWidth": 2,
        "color": "#365248"
      },
      "encoding": {
        "x": {
          "field": "left",
          "type": "quantitative"
        },
        "x2": {
          "field": "right"
        },
        "y": {
          "field": "median_value",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "income_group",
            "title": "Income group"
          },
          {
            "field": "median_value",
            "type": "quantitative",
            "title": "Median country value (tonnes/person)",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.iso_code == selected_country"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 120,
        "color": "#b56b2a",
        "stroke": "#713e15",
        "strokeWidth": 1,
        "opacity": 1
      }
    },
    {
      "transform": [
        {
          "filter": "datum.iso_code == selected_country"
        },
        {
          "calculate": "datum.country + ' · ' + format(datum.ghg_per_capita, '.1f')",
          "as": "selected_label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -9,
        "dy": -13,
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#95511e"
      },
      "encoding": {
        "text": {
          "field": "selected_label"
        }
      }
    }
  ],
  "config": {
    "font": "Segoe UI",
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "labelFont": "Segoe UI",
      "titleFont": "Segoe UI",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 400,
      "gridColor": "#dedfd4",
      "gridOpacity": 0.65,
      "labelColor": "#526358",
      "titleColor": "#526358",
      "titlePadding": 12
    }
  },
