{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 230,
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "background": "transparent",
  "data": {
    "url": "data/ghg_continent_sector_shares_2025.csv",
    "format": {
      "type": "csv",
      "parse": {
        "share": "number",
        "emissions_mt": "number",
        "continent_total_mt": "number",
        "country_count": "number"
      }
    }
  },
  "encoding": {
    "x": {
      "field": "sector",
      "type": "nominal",
      "sort": [
        "Power & heat",
        "Other energy",
        "Manufacturing",
        "Transport",
        "Buildings",
        "Industry processes",
        "Agriculture",
        "Waste & other"
      ],
      "title": null,
      "axis": {
        "labelAngle": -25,
        "labelLimit": 160,
        "labelFontSize": 12,
        "labelFont": "Manrope",
        "titleFont": "Manrope",
        "titleFontSize": 13,
        "titleFontWeight": 400,
        "labelColor": "#526358",
        "titleColor": "#526358"
      }
    },
    "y": {
      "field": "continent",
      "type": "nominal",
      "sort": [
        "Asia",
        "Europe",
        "North America",
        "South America",
        "Africa",
        "Oceania"
      ],
      "title": null
    },
    "color": {
      "field": "share",
      "type": "quantitative",
      "title": "Share of continental emissions",
      "scale": {
        "domain": [
          0,
          0.5
        ],
        "range": [
          "#edf1e8",
          "#176e63"
        ],
        "nice": false
      },
      "legend": null
    },
    "tooltip": [
      {
        "field": "continent",
        "title": "Continent"
      },
      {
        "field": "sector",
        "title": "Sector"
      },
      {
        "field": "share",
        "type": "quantitative",
        "title": "Share of continental emissions",
        "format": ".1%"
      },
      {
        "field": "emissions_mt",
        "type": "quantitative",
        "title": "Sector emissions (Mt CO₂eq)",
        "format": ",.1f"
      },
      {
        "field": "continent_total_mt",
        "type": "quantitative",
        "title": "Continental total (Mt CO₂eq)",
        "format": ",.1f"
      },
      {
        "field": "country_count",
        "type": "quantitative",
        "title": "Countries / territories",
        "format": "d"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#f7f6ef",
        "strokeWidth": 2
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Manrope",
    "axis": {
      "domain": false,
      "ticks": false,
      "labelPadding": 7,
      "labelColor": "#526358",
      "grid": false,
      "labelFont": "Manrope",
      "titleFont": "Manrope",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleFontWeight": 400,
      "titleColor": "#526358"
    },
    "legend": {
      "labelColor": "#526358",
      "titleColor": "#173f35",
      "titleFontSize": 13,
      "labelFont": "Manrope",
      "titleFont": "Manrope",
      "labelFontSize": 12,
      "titleFontWeight": 600
    },
    "text": {
      "font": "Manrope"
    }
  }
}
