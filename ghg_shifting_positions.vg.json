{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Bump chart: annual global emissions ranks of the ten largest 2025 emitters. All historical ranks retained.",
  "width": "container",
  "height": 300,
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "background": "transparent",
  "data": {
    "url": "data/ghg_bump_rankings.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "global_rank": "number",
        "emissions_mt": "number"
      }
    }
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": "Year",
      "scale": {
        "domain": [
          1970,
          2025
        ],
        "nice": false
      },
      "axis": {
        "values": [
          1970,
          1980,
          1990,
          2000,
          2010,
          2020,
          2025
        ],
        "format": "d",
        "grid": false,
        "labelAngle": 0,
        "labelOverlap": true,
        "labelFont": "Manrope",
        "titleFont": "Manrope",
        "labelFontSize": 12,
        "titleFontSize": 13,
        "titleFontWeight": 400,
        "labelColor": "#526358",
        "titleColor": "#526358"
      }
    },
    "y": {
      "field": "global_rank",
      "type": "quantitative",
      "title": "Global rank · 1 = highest emissions",
      "scale": {
        "domain": [
          1,
          37
        ],
        "reverse": true,
        "zero": false,
        "nice": false
      },
      "axis": {
        "values": [
          1,
          5,
          10,
          15,
          20,
          25,
          30,
          35,
          37
        ],
        "format": "d",
        "labelFont": "Manrope",
        "titleFont": "Manrope",
        "labelFontSize": 12,
        "titleFontSize": 13,
        "titleFontWeight": 400,
        "labelColor": "#526358",
        "titleColor": "#526358"
      }
    },
    "color": {
      "field": "country",
      "type": "nominal",
      "scale": {
        "domain": [
          "China",
          "United States",
          "India",
          "Russian Federation",
          "Indonesia",
          "Brazil",
          "Iran, Islamic Republic of",
          "Japan",
          "Saudi Arabia",
          "Canada"
        ],
        "range": [
          "#176e63",
          "#b56b2a",
          "#548faf",
          "#8c719d",
          "#788345",
          "#b19a48",
          "#5e7396",
          "#66756c",
          "#ac7b8d",
          "#6c787f"
        ]
      },
      "legend": null
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2
      },
      "encoding": {
        "order": {
          "field": "year"
        },
        "opacity": {
          "condition": {
            "test": "legend_country === '' || !datum.country || datum.country === legend_country",
            "value": 1
          },
          "value": 0.12
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 12
      },
      "encoding": {
        "tooltip": [
          {
            "field": "country",
            "title": "Country"
          },
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "global_rank",
            "type": "quantitative",
            "title": "Global rank",
            "format": "d"
          },
          {
            "field": "emissions_mt",
            "type": "quantitative",
            "title": "Emissions (Mt CO₂eq)",
            "format": ",.2f"
          }
        ],
        "color": {
          "field": "country",
          "type": "nominal",
          "scale": {
            "domain": [
              "China",
              "United States",
              "India",
