{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Annual greenhouse gas emissions for six selected countries, 1970–2025; excludes land use, land-use change and forestry.",
  "width": "container",
  "height": 400,
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "background": "#fbfcf8",
  "data": {
    "url": "data/ghg_by_year.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "emissions_mt": "number"
      }
    }
  },
  "transform": [
    {
      "filter": {
        "field": "iso_code",
        "oneOf": [
          "CHN",
          "USA",
          "IND",
          "RUS",
          "JPN",
          "AUS"
        ]
      }
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": "Year",
      "scale": {
        "domain": [
          1970,
          2025
        ],
        "nice": false
      },
      "axis": {
        "format": "d",
        "values": [
          1970,
          1980,
          1990,
          2000,
          2010,
          2020,
          2025
        ],
        "grid": false,
        "labelOverlap": true
      }
    },
    "y": {
      "field": "emissions_mt",
      "type": "quantitative",
      "title": "Emissions (Mt CO₂eq)",
      "scale": {
        "zero": true
      },
      "axis": {
        "format": ",.0f",
        "tickCount": 6
      }
    },
    "color": {
      "field": "country",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "China",
          "United States",
          "India",
          "Russian Federation",
          "Japan",
          "Australia"
        ],
        "range": [
          "#2764A5",
          "#E69F00",
          "#29A7B8",
          "#8B6BB3",
          "#596579",
          "#B47B38"
        ]
      },
      "legend": {
        "title": null,
        "orient": "bottom",
        "direction": "vertical",
        "columns": {
          "expr": "width < 500 ? 1 : 3"
        },
        "labelLimit": 250,
        "labelFontSize": 13,
        "symbolType": "stroke",
        "symbolStrokeWidth": 3,
        "columnPadding": 24,
        "rowPadding": 10,
        "padding": 14
      }
    },
    "opacity": {
      "condition": {
        "param": "trend_highlight",
        "value": 1
      },
      "value": 0.15
    },
    "order": {
      "field": "year",
      "type": "quantitative"
    }
  },
  "config": {
    "font": "Segoe UI",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "labelColor": "#526358",
      "titleColor": "#253d35",
      "gridColor": "#e2e8de",
      "domainColor": "#bbc8b8",
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 12,
      "labelColor": "#526358",
      "padding": 14
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.8,
        "clip": true
      },
      "params": [
        {
          "name": "trend_highlight",
          "select": {
            "type": "point",
            "fields": [
              "country"
            ],
            "on": [],
            "toggle": "true",
            "clear": false
          },
          "bind": "legend"
        }
      ],
      "encoding": {
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "emissions_mt",
            "type": "quantitative",
            "title": "Emissions (Mt CO₂eq)",
            "format": ",.1f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "year": 2004
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [
          4,
          4
        ],
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative"
        },
        "y": {
          "value": 0
        },
        "y2": {
          "value": 400
        },
        "color": {
          "value": "#708074"
        },
        "opacity": {
          "value": 0.65
        },
        "tooltip": {
          "value": "2004: China first exceeds United States emissions."
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "label": [
              "2004: China overtakes",
              "the United States."
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 13,
        "fontWeight": 600,
        "lineBreak": "\n"
      },
      "encoding": {
        "x": {
          "value": 12
        },
        "y": {
          "value": 12
        },
        "text": {
          "field": "label"
        },
        "color": {
          "value": "#253d35"
        },
        "opacity": {
          "value": 1
        },
        "tooltip": {
          "value": "China first exceeds United States emissions in 2004 in this dataset."
        }
      }
    }
  ]
}